rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // PILLAR 1: GLOBAL SAFETY NET (DEFAULT-DENY CATCH-ALL)
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // PHASE 3: HARDENED GLOBAL PRIMITIVES
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // =========================================================================
    // PILLAR 2 & 5: VALIDATION BLUEPRINT FOR UserProfile (/users/{userId})
    // Verbatim bounds and regex patterns synchronized with firebase-blueprint.json
    // =========================================================================
    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid',
          'accountType',
          'tin',
          'rdbNumber',
          'businessName',
          'contactPerson',
          'email',
          'phone',
          'district',
          'province',
          'commercialHub',
          'offeringType',
          'sectorCategory',
          'specificOfferings',
          'selectedHsCode',
          'products',
          'certifications',
          'monthlyCapacityKg',
          'exWorksPriceRwf',
          'savedPartnerIds',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'accountType',
          'tin',
          'rdbNumber',
          'businessName',
          'contactPerson',
          'email',
          'phone',
          'district',
          'province',
          'commercialHub',
          'offeringType',
          'sectorCategory',
          'specificOfferings',
          'selectedHsCode',
          'products',
          'certifications',
          'monthlyCapacityKg',
          'exWorksPriceRwf',
          'savedPartnerIds',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.uid == request.auth.uid
        && data.accountType is string && data.accountType.size() >= 7 && data.accountType.size() <= 20 && (data.accountType == 'business' || data.accountType == 'partner')
        && data.tin is string && data.tin.size() >= 3 && data.tin.size() <= 30 && data.tin.matches('^[a-zA-Z0-9_\\-]+$')
        && data.rdbNumber is string && data.rdbNumber.size() >= 2 && data.rdbNumber.size() <= 40
        && data.businessName is string && data.businessName.size() >= 2 && data.businessName.size() <= 160
        && data.contactPerson is string && data.contactPerson.size() >= 2 && data.contactPerson.size() >= 2 && data.contactPerson.size() <= 120
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 160
        && data.phone is string && data.phone.size() >= 5 && data.phone.size() <= 40
        && data.district is string && data.district.size() >= 2 && data.district.size() <= 60
        && data.province is string && data.province.size() >= 2 && data.province.size() <= 80
        && data.commercialHub is string && data.commercialHub.size() >= 2 && data.commercialHub.size() <= 160
        && data.offeringType is string && data.offeringType.size() >= 5 && data.offeringType.size() <= 30 && (data.offeringType == 'Goods' || data.offeringType == 'Services' || data.offeringType == 'Goods & Services')
        && data.sectorCategory is string && data.sectorCategory.size() >= 2 && data.sectorCategory.size() <= 160
        && data.specificOfferings is string && data.specificOfferings.size() >= 2 && data.specificOfferings.size() <= 500
        && data.selectedHsCode is string && data.selectedHsCode.size() >= 2 && data.selectedHsCode.size() <= 20
        && data.products is list && data.products.size() >= 1 && data.products.size() <= 10 && data.products[0] is string && data.products[0].size() <= 20
        && data.certifications is list && data.certifications.size() >= 1 && data.certifications.size() <= 10 && data.certifications[0] is string && data.certifications[0].size() <= 40
        && data.monthlyCapacityKg is int && data.monthlyCapacityKg >= 0 && data.monthlyCapacityKg <= 100000000
        && data.exWorksPriceRwf is int && data.exWorksPriceRwf >= 0 && data.exWorksPriceRwf <= 100000000
        && data.savedPartnerIds is list && data.savedPartnerIds.size() >= 1 && data.savedPartnerIds.size() <= 10 && data.savedPartnerIds[0] is string && data.savedPartnerIds[0].size() <= 40
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // =========================================================================
    // COLLECTION: /users/{userId} (PII ISOLATED PER OWNER UID)
    // =========================================================================
    match /users/{userId} {
      allow get: if isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId;

      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && request.auth.uid == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && request.auth.uid == userId
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Update full enterprise / partner profile settings
          incoming().diff(existing()).affectedKeys().hasOnly([
            'accountType',
            'tin',
            'rdbNumber',
            'businessName',
            'contactPerson',
            'email',
            'phone',
            'district',
            'province',
            'commercialHub',
            'offeringType',
            'sectorCategory',
            'specificOfferings',
            'selectedHsCode',
            'products',
            'certifications',
            'monthlyCapacityKg',
            'exWorksPriceRwf',
            'savedPartnerIds',
            'updatedAt'
          ]) ||
          // Action 2: Update saved shortlist partners only
          incoming().diff(existing()).affectedKeys().hasOnly([
            'savedPartnerIds',
            'updatedAt'
          ])
        );

      allow delete: if isVerifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId;
    }
  }
}
